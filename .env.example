NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
DATABASE_URL=your_database_url
TRUELAYER_CLIENT_ID=your_truelayer_client_id
TRUELAYER_CLIENT_SECRET=your_truelayer_client_secret
# "live" uses real banks and auth.truelayer.com/api.truelayer.com - only set
# this in an environment configured with LIVE client credentials, never with
# sandbox ones. Omit (or any other value) for the sandbox mock bank.
TRUELAYER_ENV=sandbox
# Live mode only. Which countries'/banks' selection screen to show. Get the
# exact value from the TrueLayer Console > Data API > Auth Link Builder
# (e.g. to add Spain alongside the UK). Defaults to uk-ob-all if unset.
# TRUELAYER_PROVIDERS=uk-ob-all
# Not read directly by the app (the redirect URI is built from the request
# origin), but must match what's registered in the TrueLayer console.
TRUELAYER_REDIRECT_URI=http://localhost:3000/subscription-guardian/callback
# Salt Edge (https://www.saltedge.com/clients/profile/secrets). Calls are
# authenticated with the app's own App-id/Secret - there's no user token.
SALTEDGE_APP_ID=your_saltedge_app_id
SALTEDGE_SECRET=your_saltedge_secret
# "live" shows real banks only. Anything else also offers Salt Edge's fake
# providers (country XF), which is all a test/pending Salt Edge app can use.
SALTEDGE_ENV=sandbox
